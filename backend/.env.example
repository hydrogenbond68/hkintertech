# Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/hk-intertech?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email Configuration (for password reset)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Harykims Intertech <noreply@harykims.com>

# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-domain.com
CORS_ORIGINS=https://your-frontend-domain.com

# Redis catalog cache and Socket.IO adapter
REDIS_URL=redis://127.0.0.1:6379
CATALOG_CACHE_TTL=10
CATALOG_STALE_TTL=30

# M-Pesa Daraja
MPESA_ENV=sandbox
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/mpesa/callback
