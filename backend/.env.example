# Database Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/hk-intertech?retryWrites=true&w=majority

# JWT Configuration
# REQUIRED in production and must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The API refuses to start in production if this is missing or too short.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# Email Configuration (for password reset)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Harykims Intertech <noreply@harykims.com>

# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-domain.com

# CORS allow-list (comma-separated). Required in production: the API refuses to
# start without it, and rejects "*" outright because credentialed requests with a
# reflected Origin would let any site act as the signed-in user.
CORS_ORIGINS=https://your-frontend-domain.com

# Rate limiting (per 15-minute window)
API_RATE_LIMIT=600
AUTH_RATE_LIMIT=40

# Redis catalog cache and Socket.IO adapter
# Without Redis the API still boots, but /ready returns 503, catalog caching is
# bypassed, and order events do not cross instance boundaries.
REDIS_URL=redis://127.0.0.1:6379
CATALOG_CACHE_TTL=10
CATALOG_STALE_TTL=30

# M-Pesa Daraja
MPESA_ENV=sandbox
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/mpesa/callback
